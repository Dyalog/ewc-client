 {presel} CBRunDemo args;e;scores;cols;fcol;pass;ii;ids;target;demo;sf;f;name;sel
 :If 2=⎕NC 'presel'
     f←'' ⍝ ?Demo= launch: no event, so there is no originating form to probe
     →RUN ⊣ demo←presel
 :EndIf

 Event←⎕NS''
 e←Event.Event←⎕NS''
 e.(ID EventName Info)←(2↑args),⊂2↓args
 sf←{(1-(⌽⍵)⍳'.')↓⍵}⊃args
 f←{(¯1+⍵⍳'.')↑⍵}⊃args
 EWC.USEWIN32←0 ⍝ ×(sf,'USEWIN32') eWG 'State'

 :Select ¯4↑1⊃args
 :Case 'CALE' ⍝ SCALE
    COORD←(1+(1⊃args)eWG 'State')⊃'Pixel' 'ScaledPixel'
    →0

 :Case  'STOP'
     eEX f
     →0
 :Case 'DEVT'
     :If 9=⎕NC name←f,'.HR'
         ⍎name,'.ShowDevTools 1'
     :EndIf
     →0
 :EndSelect

 sel←(⊃args)eWG'SelItems'
 ii←sel⍳1

 ⍝ addDemoMenu makes item 1 the "Pick a Demo" placeholder - selecting it
 ⍝ rebuilds the demo menu form, i.e. goes back to the demo home page
 :If 1=ii
     DemoMenu EWC.CONNECTED
     →0
 :EndIf

 demo←'Demo',ii⊃(⊃args)eWG'Items'

RUN:
 :If 3=⎕NC demo
     ⎕←''
     ⎕←'Running "',demo,'" with',((~EWC.USEWIN32)/'out'),' Win32'
     (⍎demo)EWC.CONNECTED
     :If 0=≢f ⍝ ?Demo= launch: add the menu to the form the demo just created
         addDemoMenu ''
     :ElseIf 0=⎕NC f ⍝ the demo replaced the form the menu was on
         DemoMenu EWC.CONNECTED
     :Else
         addDemoMenu f
     :EndIf
 :EndIf
