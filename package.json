{
  "name": "ewc",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "dev": "yarn workspace ewc-client dev",
    "build": "yarn workspace ewc-client build",
    "lint": "yarn workspace ewc-client lint",
    "preview": "yarn workspace ewc-client preview",
    "demotests:browser:headed": "HEADED=1 BROWSER_URL=http://localhost:5173 playwright test --headed",
    "demotests:browser:debug": "BROWSER_URL=http://localhost:5173 playwright test --debug",
    "demotests:update-baselines": "UPDATE_BASELINES=1 BROWSER_URL=http://localhost:5173 playwright test",
    "demotests:screenshots": "SCREENSHOTS=always playwright test",
    "demotests:basic": "playwright test e2e/demo/tests/basic",
    "demotests:browser": "BROWSER_URL=http://localhost:5173 playwright test",
    "demotests:browser:basic": "BROWSER_URL=http://localhost:5173 playwright test e2e/demo/tests/basic",
    "demotests:report": "playwright show-report",
    "demotests:record": "playwright codegen http://localhost:5173",
    "demotests:record:desktop": "playwright codegen --connect-over-cdp=http://localhost:8080",
    "demotests:visual": "docker run --rm --add-host=host.docker.internal:host-gateway -v \"$PWD\":/work -w /work -e BROWSER_URL=http://host.docker.internal:22322 mcr.microsoft.com/playwright:v1.60.0-noble npx playwright test",
    "demotests:visual:update": "docker run --rm --add-host=host.docker.internal:host-gateway -v \"$PWD\":/work -w /work -e BROWSER_URL=http://host.docker.internal:22322 -e UPDATE_BASELINES=1 mcr.microsoft.com/playwright:v1.60.0-noble npx playwright test",
    "ewc-demo:start": "bash ci/ewc-demo-start.sh",
    "ewc-demo:stop": "docker rm -f ewc-demo",
    "ewc-demo:logs": "docker logs -f ewc-demo",
    "ewc-demo:restart": "yarn ewc-demo:start"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.0.1",
    "typescript": "^5.9.3"
  }
}
